# MySQL连接配置
# 请根据您的MySQL服务器配置修改以下变量

# MySQL服务器地址
DB_HOST=localhost

# MySQL端口
DB_PORT=3306

# MySQL用户名
DB_USER=root

# MySQL密码（明文）
DB_PASSWORD=password

# 数据库名称
DB_NAME=model_training

# 字符集
DB_CHARSET=utf8mb4

# 排序规则
DB_COLLATION=utf8mb4_unicode_ci

# 连接池大小
DB_POOL_SIZE=10

# 最大溢出连接数
DB_MAX_OVERFLOW=20

# 获取连接超时时间（秒）
DB_POOL_TIMEOUT=30

# 连接回收时间（秒）
DB_POOL_RECYCLE=3600

# 是否显示SQL语句（开发环境设为true）
DB_ECHO=false

# 数据持久化目录
DATA_DIR=./data
# ============================================================
# 多机多卡无状态训练（控制/协调/状态/计算 四平面）新增配置
# ============================================================

# ---- 状态平面（数据集/断点/产物的权威存储）----
# local : 本地文件（单机零依赖；默认），数据落 DATA_DIR
# s3    : S3 兼容对象存储（多机共享状态，checkpoint 跨服务器接续训练）
#         支持 SeaweedFS / 阿里云 OSS(S3 网关) / 腾讯云 COS / AWS S3 等
STORAGE_BACKEND=local
# S3 端点示例：
#   SeaweedFS（本地/自建）: S3_ENDPOINT=localhost:9000
#   阿里云 OSS: S3_ENDPOINT=s3.oss-cn-hangzhou.aliyuncs.com  S3_SECURE=true
#   腾讯云 COS: S3_ENDPOINT=cos.ap-guangzhou.myqcloud.com    S3_SECURE=true
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=mtp-artifacts
S3_SECURE=false
# SeaweedFS 容器镜像源（compose 内置状态平面；国内网络拉取失败时替换为国内镜像源）：
#   SEAWEEDFS_IMAGE=chrislusf/seaweedfs:latest                         # 官方（默认）
#   SEAWEEDFS_IMAGE=docker.m.daocloud.io/chrislusf/seaweedfs:latest    # DaoCloud 国内镜像
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:latest
# 前端容器 Node 基础镜像源（国内网络拉取失败时替换为国内镜像源）：
#   NODE_BASE_IMAGE=node:20-alpine                              # 官方（默认）
#   NODE_BASE_IMAGE=docker.m.daocloud.io/library/node:20-alpine # DaoCloud 国内镜像
NODE_BASE_IMAGE=node:20-alpine

# 本地构建 trainer/worker 镜像时的 apt 源（国内网络拉取 deb.debian.org 慢时替换为国内镜像源）：
#   APT_MIRROR=                       # 官方（默认，空）
#   APT_MIRROR=mirrors.ustc.edu.cn    # 中科大 Debian 镜像
APT_MIRROR=

# ---- 协调平面（任务队列 + 租约/心跳）----
# 留空 = 嵌入式模式：API 进程内嵌 worker 线程，单机零依赖
# 多机模式：全部 API 与各服务器 worker 连接同一 Redis
REDIS_URL=
# 平台 Redis 密码（URL 内嵌认证优先于本变量）
REDIS_PASSWORD=

# ---- 远程服务器管理（SSH 接入的外部计算服务器）----
# 远程 worker 使用的 Redis 地址；留空时沿用 REDIS_URL。
# 与平台 Redis 不同（或认证不同）时才需要单独配置。
WORKER_REMOTE_REDIS_URL=
# 远程 worker 使用的 Redis 密码（仅当 WORKER_REMOTE_REDIS_URL 指向的 Redis
# 需要认证且密码未内嵌在 URL 中时配置）。平台密码 REDIS_PASSWORD 只在远程
# worker 复用平台 REDIS_URL 时自动沿用，避免把平台密码误发给其他 Redis。
WORKER_REMOTE_REDIS_PASSWORD=
# 远程 worker 使用的 S3 地址；留空时沿用 S3_ENDPOINT。
WORKER_REMOTE_S3_ENDPOINT=
# 页面 SSH 凭证加密主密钥（Fernet）：用
#   python3 -c 'import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
# 生成并长期保管；更换后 MySQL 中已保存的凭证无法解密，需要重新保存。
WORKER_SSH_CREDENTIAL_ENCRYPTION_KEY=

# ---- 计算平面（worker）----
# 独立 worker 数（嵌入式模式下的线程数；多机模式由 supervisor 一卡一进程）
EMBEDDED_WORKERS=2
WORKER_ID=
WORKER_HEARTBEAT_INTERVAL=10
WORKER_LEASE_TTL=30
WORKER_CHECKPOINT_INTERVAL=5
WORKER_CHECKPOINT_KEEP=3
# 一卡一进程的机器级守护
WORKER_SUPERVISOR_PROBE_INTERVAL=15
WORKER_GPU_PROBE=true
# supervisor 额外的 CPU 执行槽数（require_gpu=false 的任务）
WORKER_CPU_SLOTS=1

# ---- 任务自愈 ----
# 环境性错误（CUDA/OOM/网络瞬断等）自动重试上限：带 checkpoint 续训，不浪费已完成进度
JOB_MAX_AUTO_RETRY=5
JOB_RETRY_BACKOFF=2
# watchdog 巡检周期（秒）：重派心跳迷失任务 / 队列防丢失
WATCHDOG_INTERVAL=5
# 崩溃残留 worker 注册的清理宽限期（秒）：心跳消失超过该时长后由 watchdog 清除幽灵槽
WORKER_STALE_CLEANUP_AGE=300
