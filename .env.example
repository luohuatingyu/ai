# MySQL连接配置
# 请根据您的MySQL服务器配置修改以下变量

# MySQL服务器地址
DB_HOST=localhost

# MySQL端口
DB_PORT=3306

# MySQL用户名
DB_USER=root

# MySQL密码（明文）
DB_PASSWORD=password

# 数据库名称
DB_NAME=model_training

# 字符集
DB_CHARSET=utf8mb4

# 排序规则
DB_COLLATION=utf8mb4_unicode_ci

# 连接池大小
DB_POOL_SIZE=10

# 最大溢出连接数
DB_MAX_OVERFLOW=20

# 获取连接超时时间（秒）
DB_POOL_TIMEOUT=30

# 连接回收时间（秒）
DB_POOL_RECYCLE=3600

# 是否显示SQL语句（开发环境设为true）
DB_ECHO=false

# 数据持久化目录
DATA_DIR=./data