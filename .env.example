# MySQL连接配置
# 请根据您的MySQL服务器配置修改以下变量

# MySQL服务器地址
DB_HOST=localhost

# MySQL端口
DB_PORT=3306

# MySQL用户名
DB_USER=root

# MySQL密码（明文）
DB_PASSWORD=password

# 数据库名称
DB_NAME=model_training

# 字符集
DB_CHARSET=utf8mb4

# 排序规则
DB_COLLATION=utf8mb4_unicode_ci

# 连接池大小
DB_POOL_SIZE=10

# 最大溢出连接数
DB_MAX_OVERFLOW=20

# 获取连接超时时间（秒）
DB_POOL_TIMEOUT=30

# 连接回收时间（秒）
DB_POOL_RECYCLE=3600

# 是否显示SQL语句（开发环境设为true）
DB_ECHO=false

# 数据持久化目录
DATA_DIR=./data
# ============================================================
# 多机多卡无状态训练（控制/协调/状态/计算 四平面）新增配置
# ============================================================

# ---- 状态平面（数据集/断点/产物的权威存储）----
# local  : 本地文件（单机零依赖；默认），数据落 DATA_DIR
# minio  : S3/MinIO 对象存储（多机共享状态，checkpoint 跨服务器接续训练）
STORAGE_BACKEND=local
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mtp-artifacts
MINIO_SECURE=false

# ---- 协调平面（任务队列 + 租约/心跳）----
# 留空 = 嵌入式模式：API 进程内嵌 worker 线程，单机零依赖
# 多机模式：全部 API 与各服务器 worker 连接同一 Redis
REDIS_URL=

# ---- 计算平面（worker）----
# 独立 worker 数（嵌入式模式下的线程数；多机模式由 supervisor 一卡一进程）
EMBEDDED_WORKERS=2
WORKER_ID=
WORKER_HEARTBEAT_INTERVAL=10
WORKER_LEASE_TTL=30
WORKER_CHECKPOINT_INTERVAL=5
WORKER_CHECKPOINT_KEEP=3
# 一卡一进程的机器级守护
WORKER_SUPERVISOR_PROBE_INTERVAL=15
WORKER_GPU_PROBE=true
# supervisor 额外的 CPU 执行槽数（require_gpu=false 的任务）
WORKER_CPU_SLOTS=1

# ---- 任务自愈 ----
# 环境性错误（CUDA/OOM/网络瞬断等）自动重试上限：带 checkpoint 续训，不浪费已完成进度
JOB_MAX_AUTO_RETRY=5
JOB_RETRY_BACKOFF=2
# watchdog 巡检周期（秒）：重派心跳迷失任务 / 队列防丢失
WATCHDOG_INTERVAL=5
